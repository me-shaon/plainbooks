{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plainbooks",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The Worker runs only on its custom domain. Access needs a custom domain (docs/setup.md).
  // No routes here: `pnpm run ship` adds your host, or you add it in the dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*", "/render/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plainbooks",
      // Placeholder. The Deploy button and `pnpm run ship` use your real database instead.
      // Local dev keys its D1 data on this value, so keep it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "plainbooks-files" }],
  "browser": { "binding": "BROWSER" },
  "triggers": { "crons": ["*/15 * * * *"] },
  // Sign-in and setup attempt counters (src/worker/auth/rate-limit.ts).
  "durable_objects": {
    "bindings": [{ "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AuthRateLimiter"] }],
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY, RESEND_WEBHOOK_SECRET,
  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, OWNER_EMAIL, APP_URL. They are secrets, not vars, so a
  // deploy keeps them: `wrangler deploy` replaces every var with the values in this file.
  "vars": {
    "APP_ENV": "production"
  }
}
