# Secrets. The Deploy to Cloudflare button asks for the same values, except FAKE_EXTERNALS.
# To make a random value, run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Public origin of the app, with no trailing slash. For `pnpm dev`, use the URL that Vite
# prints, for example http://localhost:5173.
APP_URL=https://invoices.example.com
# Session signing secret, 32 characters or more. A new value signs everyone out.
AUTH_SECRET=replace-with-32-or-more-random-characters
# Encrypts the saved email provider keys. 32 random bytes as base64. A new value means
# you must enter the provider keys again in Settings > Email.
ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64
# Opens the setup screen that creates the first Owner. 32 characters or more.
SETUP_TOKEN=replace-with-32-or-more-random-characters
# Optional. Google sign-in shows only when both values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local only. `pnpm dev` sets APP_ENV=development.
# "1" swaps the email provider, Frankfurter, and Browser Run for fakes.
# FAKE_EXTERNALS=1
